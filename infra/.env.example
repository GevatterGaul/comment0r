TRAEFIK_DYNAMIC_FILE=./traefik/dynamic.dev.yml

# OIDC mode (used when running with --profile oidc and dynamic.oidc.yml)
OIDC_ISSUER_URL=https://accounts.google.com
OIDC_CLIENT_ID=replace-me
OIDC_CLIENT_SECRET=replace-me
OIDC_REDIRECT_URL=http://localhost/oauth2/callback
OAUTH2_PROXY_COOKIE_SECRET=replace-with-32-byte-base64

# Optional email allowlist fallback for admin API actions
ADMIN_EMAIL_ALLOWLIST=admin@example.com
